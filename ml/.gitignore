# ----------------------------
# Python / FastAPI / ML Project gitignore
# ----------------------------

# Virtual environment folders
venv/
.env/
env/
.venv/

# Environment variables
*.env
.env.local
.env.*.local

# Python bytecode
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd

# VSCode
.vscode/

# IDE stuff
.idea/
*.iml

# Mac / Linux system files
.DS_Store
Thumbs.db

# Log files
logs/
*.log

# Cache / build artifacts
.cache/
dist/
build/
*.egg-info/

# Uploaded files (optional — Thunder/Testing output)
uploads/
temp/
tmp/

# pytest / test cache
.pytest_cache/
coverage.xml

# Pip dependency folder
pip-wheel-metadata/

# FastAPI autogenerated docs compiled files (just in case)
*.sqlite3

# Jupyter Notebook checkpoints (if you experiment)
.ipynb_checkpoints/

# Node modules (if frontend exists)
node_modules/

# Output JSONs / generated ML results (optional)
output/
results/
